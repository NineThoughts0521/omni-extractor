# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: custom base URL for OpenAI API
OPENAI_MODEL=gpt-4o-mini  # Optional: model to use for extraction (default: gpt-4o-mini)

# HTTP Configuration
HTTP_TIMEOUT=30.0  # Optional: HTTP request timeout in seconds (default: 30.0)

# Concurrency Configuration
MAX_CONCURRENT_FETCH=20  # Optional: maximum concurrent HTTP fetch operations (default: 20)
MAX_CONCURRENT_EXTRACT=5  # Optional: maximum concurrent OpenAI extraction operations (default: 5)

# Retry Configuration
MAX_RETRIES=3  # Optional: maximum retry attempts for failed operations (default: 3)
RETRY_BASE_DELAY=0.5  # Optional: base delay in seconds for exponential backoff (default: 0.5)

# Logging Configuration
LOG_LEVEL=INFO  # Optional: log level - DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)